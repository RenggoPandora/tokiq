# ===========================
# tokiq — Environment Variables
# ===========================
# Salin file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke git

# Supabase (dapatkan dari: https://supabase.com/dashboard > Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hanya untuk Edge Functions (server-side, tidak boleh expose ke client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# APP_URL=https://tokiq.id
